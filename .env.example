# BYOK: paste your key in Settings inside the app, or set it here for local dev.
# Used as a fallback when no key is saved in the browser. Never commit a real key
# and never set this in a hosted build — Vite inlines it into the client bundle.
# VITE_OPENROUTER_API_KEY=

# Debug mode: logs every AI prompt + response to the browser console.
# Set to "true" to enable. Unset/anything-else = off.
# VITE_HENRO_DEBUG=true

# MCP agent bridge: connects Henro to a local mcp/ server (see mcp/README.md)
# so an MCP client (Claude Code, etc.) can read and control the canvas.
# Off by default — only enable on a build you run yourself, alongside the
# bridge server, on a machine you trust (no auth on the local socket).
# VITE_HENRO_MCP_BRIDGE=true
# VITE_HENRO_MCP_BRIDGE_URL=ws://localhost:8934
